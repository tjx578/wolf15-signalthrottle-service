APP_ENV=production
SERVICE_NAME=wolf15-signalthrottle-service

DATABASE_URL=postgresql://user:password@host:5432/dbname

LOG_TIMEZONE=UTC
OWNER_TIMEZONE=Asia/Makassar
CHART_TIME_OFFSET_HOURS=3
DEPLOYMENT_ENVIRONMENT=production
OBSERVER_MODE=observe_only
OBSERVER_AUTHORITY=observational_only
PHASE1_OBSERVE_ONLY=true
SIGNALTHROTTLE_MODE=phase1
ENABLE_TRADE_PLANS=false
ENABLE_MARKET_CONTEXT=false
ENABLE_OUTCOME_WORKER=false
ENABLE_LEGACY_REPLAY=false
EXECUTION_ALLOWED=false

# Required. Missing value makes /webhook/log fail closed with HTTP 503.
WEBHOOK_SECRET=replace-with-random-machine-secret

# Forbidden in PHASE1_OBSERVE_ONLY. A non-empty value rejects startup.
FINNHUB_API_KEY=

MIN_RADAR_MINUTES=5
MIN_STRONG_MINUTES=14
MAX_EVENT_GAP_SECONDS=300
MAX_CONTINUITY_GAP_SECONDS=90
SOFT_FINALIZE_SECONDS=90
HARD_FINALIZE_SECONDS=300

ENGINE_LOG_SYNC_ENABLED=false
ENGINE_LOG_SOURCE_URL=
ENGINE_LOG_SOURCE_TOKEN=
ENGINE_LOG_SOURCE_SERVICE=wolf15-engine
ENGINE_LOG_FETCH_FILTER=
ENGINE_LOG_SYNC_OVERLAP_SECONDS=300
DAILY_REPORT_WINDOW=utc_day

# Both are required. Missing or partial configuration denies every owner route.
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-strong-password
DASHBOARD_BASIC_AUTH_ROLE=owner_admin
